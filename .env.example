# Version-controlled runtime template. Copy to ignored .env and set local values.
# Load explicitly: uv run --env-file .env uvicorn hdfc_mistral_mvp.api:app --host 127.0.0.1 --port 8021
# Application/model code does not load this file automatically.

# Local inference origins, without /v1. Explicit settings override aliases.
INFERENCE_URL=http://127.0.0.1:11434
SUPPORT_INFERENCE_URL=http://127.0.0.1:11434
# Comma-separated exact private DNS hosts for Kubernetes; empty keeps loopback only.
INFERENCE_ALLOWED_HOSTS=
OLLAMA_URL=http://127.0.0.1:11434
SUPPORT_AGENT_MODEL=ministral-3:14b
OLLAMA_CHAT_MODEL=ministral-3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
SUPPORT_SESSION_MODE=local
SUPPORT_INFERENCE_DISABLED=0

# Local Docker Chroma / approved corpus.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8015
FAQ_COLLECTION=approved-demo-faq

# Dedicated Studio control-plane key; set locally and never commit a real value.
MISTRAL_STUDIO_API_KEY=
URGENT_SUPPORT_URL=https://www.hdfc.bank.in/credit-cards/block-loststolen-card

# Synthetic actions. Example DSN: postgresql://ROLE:PASSWORD@127.0.0.1:5432/hdfc_actions
DEMO_ACTION_DATABASE_URL=
DEMO_ACTION_DB_SCHEMA=bank_actions
DEMO_REVIEW_THRESHOLD_MINOR=1000000
DEMO_CUSTOMER_TOKEN=
DEMO_REVIEWER_TOKEN=
DEMO_REVIEW_WEBHOOK_URL=
DEMO_REVIEW_WEBHOOK_SECRET=
DEMO_REVIEW_CALLBACK_BASE_URL=http://127.0.0.1:8021

# OCR credential is intentionally separate: only explicit ingestion reads
# MISTRAL_API_KEY from mistral_keys.env. Never pass that file to the API.
